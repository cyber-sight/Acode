#!/bin/sh

case "${1:-doctor}" in
  doctor)
    printf '%s\n' 'Acode iSH environment'
    for command in sh bash git node npm python3 pip3 curl; do
      if command -v "$command" >/dev/null 2>&1; then
        printf '%s: %s\n' "$command" "$(command -v "$command")"
      else
        printf '%s: missing\n' "$command"
      fi
    done
    printf '%s\n' 'Recent kernel diagnostics:'
    dmesg 2>/dev/null | tail -n 30
    ;;
  *)
    printf '%s\n' 'Usage: acode doctor' >&2
    exit 64
    ;;
esac
